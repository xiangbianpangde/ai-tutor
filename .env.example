# 复制为 .env 后填值。.env 不入 git。

# === LLM（depth=concept/full 必填；depth=toc 可空）===
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=    # 备选

# === 数据库 ===
DATABASE_URL=sqlite:///data/tutor.db
# 生产可换 PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/tutor

# === research-tool 集成 ===
# mineru 可执行路径；不填则走 PATH
MINERU_CMD=

# Tavily 搜索（可选；不填用 DuckDuckGo）
TAVILY_API_KEY=

# === 日志 ===
LOG_LEVEL=INFO
